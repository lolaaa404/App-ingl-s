# ---------------------------------------------------------------------------
# Clave del modelo. Hace falta una de las dos; si están las dos, manda Gemini.
# ---------------------------------------------------------------------------

# Opción 1 · Gemini directo (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Opción 2 · AI Gateway de Vercel (vercel.com -> AI -> API Keys)
AI_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Modelos. Si se dejan vacíos se usa gemini-2.5-pro (Gemini) o
# anthropic/claude-sonnet-5 (Gateway).
#
# Con Gemini se pone solo el nombre:        gemini-2.5-pro · gemini-2.5-flash
# Con el Gateway, «proveedor/modelo»:       anthropic/claude-sonnet-5
# ---------------------------------------------------------------------------

MODELO_TRADUCCION=
MODELO_ANALISIS=
MODELO_QA=
MODELO_OCR=

# Carpeta donde se guardan proyectos, memorias y glosarios
DATOS_DIR=./datos
